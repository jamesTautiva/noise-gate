use crate::params::NoiseGateParams;
use nice_plug::prelude::*;
use std::sync::Arc;

pub struct NoiseGateProcessor {
    params: Arc<NoiseGateParams>,
}

impl NoiseGateProcessor {
    pub fn new(params: Arc<NoiseGateParams>) -> Self {
        Self { params }
    }

    pub fn process(&mut self, buffer: &mut Buffer, sample_rate: f32) {
        // Versión minimalista - solo passthrough
        let _sample_rate = sample_rate.max(44100.0).min(192000.0);
        
        for mut sample_block in buffer.iter_samples() {
            for sample in sample_block.iter_mut() {
                // Passthrough simple - sin procesamiento
                *sample = *sample;
            }
        }
    }

    pub fn meter(&self) -> Arc<crate::meter::SharedMeter> {
        Arc::new(crate::meter::SharedMeter::new())
    }
}
        if self.params.pick_detector_enabled.value() {
            self.pick_detector.set_sensitivity(self.params.pick_sensitivity.value());
        }
        if self.params.palm_mute_enabled.value() {
            self.palm_mute_detector.set_threshold(self.params.palm_mute_threshold.value());
        }
        if self.params.adaptive_threshold_enabled.value() {
            self.adaptive_threshold.set_speed(self.params.adaptive_threshold_speed.value());
        }
        
        self.detector.set_thresholds(open_threshold, close_threshold);
        self.envelope.set_coefficients(attack_coeff, release_coeff);
        self.envelope.set_hold(self.params.hold_ms.value(), sample_rate);
        self.envelope.set_adaptive_release(self.params.adaptive_release.value());
        self.gain.set_range(self.params.range_db.value());

        for mut sample_block in buffer.iter_samples() {
            let mut raw_peak = 0.0f32;
            for sample in sample_block.iter_mut() {
                raw_peak = raw_peak.max(sample.abs());
                // Reactivado con protección contra NaN/Inf
                if sample.is_finite() {
                    self.meter.push_waveform_sample(*sample);
                }
                
                // Reactivado FFT buffer con protección
                if self.fft_counter < 256 && sample.is_finite() {
                    self.fft_buffer[self.fft_counter] = *sample;
                    self.fft_counter += 1;
                }
            }

            // Reactivado con protección
            if raw_peak.is_finite() {
                self.meter.set_input_peak(raw_peak);
            }

            let filtered_peak = self.hpf.process(raw_peak, hp_alpha);
            let filtered_peak = self.lpf.process(filtered_peak, lp_alpha);
            
            // Pick Detector - detecta ataques de púa
            let pick_attack = if self.params.pick_detector_enabled.value() {
                self.pick_detector.process(raw_peak)
            } else {
                false
            };
            
            // Palm Mute Detector - detecta riffs muteados
            let is_palm_mute = if self.params.palm_mute_enabled.value() {
                self.palm_mute_detector.process(raw_peak)
            } else {
                false
            };
            
            // Noise Classification - clasifica tipo de señal (para uso futuro/visualización)
            let _noise_type = if self.params.noise_classification_enabled.value() {
                self.noise_classifier.process(raw_peak)
            } else {
                crate::dsp::metal_tools::NoiseType::String
            };
            
            // Smart Gate - modo automático
            let mut effective_threshold = open_threshold;
            if self.params.smart_gate_enabled.value() {
                let smart_threshold_db = self.smart_gate.process(raw_peak);
                effective_threshold = util::db_to_gain(smart_threshold_db);
            }
            
            // Adaptive Threshold - threshold dinámico
            if self.params.adaptive_threshold_enabled.value() {
                let adaptive_threshold_db = self.adaptive_threshold.process(raw_peak, self.params.threshold_db.value());
                effective_threshold = util::db_to_gain(adaptive_threshold_db);
            }
            
            // Aplicar threshold modificado si las herramientas están activas
            let is_open = if self.params.pick_detector_enabled.value() && pick_attack {
                true // Forzar apertura en ataque de púa
            } else if self.params.palm_mute_enabled.value() && is_palm_mute {
                self.detector.process(filtered_peak * 0.8) // Palm mute requiere menos threshold
            } else {
                self.detector.set_thresholds(effective_threshold, effective_threshold * util::db_to_gain(-3.0));
                self.detector.process(filtered_peak)
            };
            
            // Reactivado con protección
            self.meter.set_gate_open(is_open);
            let target_gain = if is_open { 1.0 } else { 0.0 };
            let envelope_value = self.envelope.process(target_gain);
            let final_gain = self.gain.process(envelope_value);
            let gain_reduction = 1.0 - final_gain;
            // Reactivado con protección
            if gain_reduction.is_finite() {
                self.meter.set_gain_reduction(gain_reduction);
            }

            // Aplicar lookahead si está activo
            if lookahead_samples > 0 {
                // Limitar el delay buffer para evitar overflow
                let max_buffer_size = lookahead_samples + 1024;
                while self.delay_buffer.len() > max_buffer_size {
                    self.delay_buffer.pop_front();
                }
                
                for sample in sample_block.iter_mut() {
                    self.delay_buffer.push_back(*sample);
                    if self.delay_buffer.len() > lookahead_samples {
                        if let Some(delayed_sample) = self.delay_buffer.pop_front() {
                            *sample = delayed_sample;
                        }
                    }
                }
            }

            let mut output_peak = 0.0f32;
            for sample in sample_block.iter_mut() {
                *sample *= final_gain;
                output_peak = output_peak.max(sample.abs());
            }
            // Reactivado con protección
            if output_peak.is_finite() {
                self.meter.set_output_peak(output_peak);
            }
        }
        
        // Reactivado FFT con protección
        if self.fft_counter >= 256 {
            self.fft_counter = 0;
            let spectrum = self.compute_fft(&self.fft_buffer);
            // Solo guardar si el spectrum es válido
            if !spectrum.is_empty() && spectrum.iter().all(|&x| x.is_finite()) {
                self.meter.set_fft_spectrum(spectrum);
            }
        }
    }
    
    // FFT simple usando algoritmo de Cooley-Tukey (solo para potencias de 2)
    fn compute_fft(&self, input: &[f32]) -> Vec<f32> {
        let n = input.len();
        if n == 0 {
            return vec![];
        }
        
        // Convertir a números complejos (parte imaginaria = 0)
        let mut data: Vec<(f32, f32)> = input.iter().map(|&x| (x, 0.0)).collect();
        
        // Bit-reversal permutation
        let mut rev = vec![0usize; n];
        let mut k = n;
        let mut shift = 0usize;
        while k > 1 {
            k >>= 1;
            shift += 1;
        }
        
        for i in 0..n {
            rev[i] = i.reverse_bits() >> (32 - shift);
        }
        
        for i in 0..n {
            if i < rev[i] {
                data.swap(i, rev[i]);
            }
        }
        
        // FFT Cooley-Tukey
        let mut len = 2;
        while len <= n {
            let half_len = len / 2;
            let angle = -2.0 * PI / len as f32;
            let w_len = (angle.cos(), angle.sin());
            
            for i in (0..n).step_by(len) {
                let mut w = (1.0, 0.0);
                for j in 0..half_len {
                    let u = data[i + j];
                    let v = (
                        w.0 * data[i + j + half_len].0 - w.1 * data[i + j + half_len].1,
                        w.0 * data[i + j + half_len].1 + w.1 * data[i + j + half_len].0,
                    );
                    
                    data[i + j] = (u.0 + v.0, u.1 + v.1);
                    data[i + j + half_len] = (u.0 - v.0, u.1 - v.1);
                    
                    w = (
                        w.0 * w_len.0 - w.1 * w_len.1,
                        w.0 * w_len.1 + w.1 * w_len.0,
                    );
                }
            }
            len *= 2;
        }
        
        // Calcular magnitud y devolver solo la mitad (frecuencias positivas)
        let mut spectrum = Vec::with_capacity(n / 2);
        for i in 0..n / 2 {
            let magnitude = (data[i].0 * data[i].0 + data[i].1 * data[i].1).sqrt();
            spectrum.push(magnitude);
        }
        
        spectrum
    }

    pub fn meter(&self) -> Arc<SharedMeter> {
        self.meter.clone()
    }
}
